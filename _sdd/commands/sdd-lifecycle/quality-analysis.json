{
  "command_id": "quality-analysis",
  "name": "质量分析",
  "version": "1.0.0",
  "category": "sdd-lifecycle",
  "type": "atomic",
  "description": "执行全面的代码质量分析和架构评估",

  "input_schema": {
    "type": "object",
    "properties": {
      "analysis_scope": {
        "type": "string",
        "enum": ["full_project", "specific_module", "recent_changes"],
        "description": "分析范围",
        "default": "recent_changes"
      },
      "quality_aspects": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": ["code_quality", "architecture", "performance", "security", "maintainability"]
        },
        "description": "质量分析维度",
        "default": ["code_quality", "architecture"]
      },
      "target_path": {
        "type": "string",
        "description": "分析目标路径",
        "default": "."
      },
      "constitution_compliance": {
        "type": "boolean",
        "description": "是否检查宪法合规性",
        "default": true
      }
    },
    "required": []
  },

  "output_schema": {
    "type": "object",
    "properties": {
      "quality_report": {
        "type": "object",
        "properties": {
          "overall_score": {"type": "number"},
          "analysis_summary": {"type": "string"},
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "category": {"type": "string"},
                "severity": {"type": "string"},
                "description": {"type": "string"},
                "recommendations": {"type": "array", "items": {"type": "string"}}
              }
            }
          },
          "constitution_compliance": {
            "type": "object",
            "properties": {
              "compliant": {"type": "boolean"},
              "violations": {"type": "array", "items": {"type": "string"}},
              "improvements": {"type": "array", "items": {"type": "string"}}
            }
          },
          "next_steps": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    }
  },

  "implementation": {
    "tools": ["Read", "Grep", "Bash", "Write"],
    "timeout": 45000,
    "workflow_phase": "quality_assurance"
  },

  "sdd_workflow": {
    "phase": "quality_assurance",
    "agent": "analyzer",
    "next_commands": ["lessons-capture", "compliance-check"]
  }
}