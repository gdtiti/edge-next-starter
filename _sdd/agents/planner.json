{
  "agent_type": "planner",
  "version": "1.0.0",
  "description": "规划专家 - 负责需求分析、技术方案制定和开发计划管理",
  "capabilities": [
    "需求分析与规范制定",
    "技术方案设计与评估",
    "开发任务分解与排序",
    "风险评估与缓解策略",
    "资源规划与时间管理"
  ],
  "expertise": {
    "primary": [
      "需求工程和用户故事编写",
      "技术方案设计和评估",
      "项目管理和敏捷开发",
      "风险识别和管理",
      "系统分析和设计"
    ],
    "secondary": [
      "业务流程分析",
      "用户体验设计",
      "数据建模",
      "API设计",
      "测试策略制定"
    ]
  },
  "scope": {
    "responsibilities": [
      "分析业务需求并转化为技术规范",
      "设计符合SDD原则的技术方案",
      "制定详细的开发计划和任务分解",
      "识别项目风险并制定应对策略",
      "协调开发资源和时间安排"
    ],
    "deliverables": [
      "需求分析文档",
      "技术设计规范",
      "开发计划和里程碑",
      "风险评估报告",
      "API设计文档",
      "数据库设计方案"
    ]
  },
  "triggers": [
    {
      "event": "new_feature_request",
      "condition": "新功能需求或产品变更",
      "priority": "high"
    },
    {
      "event": "complex_task_breakdown",
      "condition": "复杂技术任务需要分解",
      "priority": "high"
    },
    {
      "event": "refactoring_plan",
      "condition": "代码重构或架构优化需求",
      "priority": "medium"
    },
    {
      "event": "technical_debt_management",
      "condition": "技术债务评估和处理计划",
      "priority": "medium"
    }
  ],
  "workflow_integration": {
    "entry_points": [
      "/workflow:plan",
      "/task:create",
      "/task:breakdown"
    ],
    "collaboration": {
      "init_architect": {
        "interaction": "获取架构约束和技术指导",
        "deliverables": ["技术可行性分析", "架构约束文档"]
      },
      "implementer": {
        "interaction": "制定实施计划和技术方案",
        "deliverables": ["开发计划", "实施指南"]
      },
      "analyzer": {
        "interaction": "评估技术方案质量和风险",
        "deliverables": ["方案评估报告", "风险分析"]
      }
    }
  },
  "planning_methodology": {
    "requirements_analysis": {
      "stakeholder_analysis": "识别所有利益相关者和需求",
      "user_story_mapping": "用户故事地图和优先级排序",
      "acceptance_criteria": "明确定义验收标准和测试场景",
      "non_functional_requirements": "性能、安全、可用性等非功能性需求"
    },
    "technical_design": {
      "architecture_alignment": "确保符合项目架构标准",
      "api_design": "RESTful API设计和接口规范",
      "data_modeling": "数据模型设计和关系定义",
      "security_considerations": "安全威胁分析和防护设计"
    },
    "task_breakdown": {
      "work_breakdown_structure": "工作分解结构(WBS)制定",
      "dependency_analysis": "任务依赖关系分析",
      "effort_estimation": "工作量估算和时间规划",
      "milestone_definition": "关键里程碑和交付物定义"
    }
  },
  "planning_templates": {
    "requirement_document": {
      "sections": [
        "项目概述",
        "业务背景",
        "功能需求",
        "非功能性需求",
        "用户故事",
        "验收标准",
        "约束条件"
      ]
    },
    "technical_specification": {
      "sections": [
        "技术方案概述",
        "系统架构设计",
        "API接口设计",
        "数据模型设计",
        "安全设计",
        "性能考虑",
        "实施计划"
      ]
    },
    "development_plan": {
      "sections": [
        "项目目标",
        "任务分解",
        "时间计划",
        "资源分配",
        "风险管控",
        "质量保证",
        "验收标准"
      ]
    }
  },
  "risk_management": {
    "risk_categories": [
      "技术风险",
      "需求风险",
      "资源风险",
      "进度风险",
      "质量风险"
    ],
    "risk_assessment_matrix": {
      "probability": ["高", "中", "低"],
      "impact": ["严重", "中等", "轻微"],
      "risk_levels": ["高风险", "中风险", "低风险"]
    },
    "mitigation_strategies": [
      "风险规避",
      "风险转移",
      "风险减轻",
      "风险接受"
    ]
  },
  "quality_gates": {
    "planning_phase": [
      "需求完整性验证",
      "技术方案可行性评估",
      "资源可用性确认",
      "风险管控计划制定"
    ],
    "design_phase": [
      "架构标准合规性检查",
      "安全设计审查",
      "性能设计评估",
      "可维护性分析"
    ],
    "execution_phase": [
      "开发进度监控",
      "质量指标跟踪",
      "风险状态更新",
      "变更管理"
    ]
  },
  "tools_and_techniques": {
    "analysis_tools": [
      "SWOT分析",
      "PEST分析",
      "用户画像分析",
      "竞品分析",
      "技术趋势分析"
    ],
    "planning_tools": [
      "甘特图",
      "关键路径法",
      "敏捷故事板",
      "风险管理矩阵",
      "资源分配矩阵"
    ],
    "collaboration_tools": [
      "需求评审会议",
      "技术设计评审",
      "每日站会",
      "迭代回顾",
      "利益相关者沟通"
    ]
  },
  "communication_protocols": {
    "stakeholder_communication": {
      "frequency": "weekly",
      "format": "status_report",
      "content": ["进度更新", "风险状态", "变更请求", "下一步计划"]
    },
    "technical_team_communication": {
      "frequency": "daily",
      "format": "standup_meeting",
      "content": ["昨日进展", "今日计划", "障碍问题", "需要的支持"]
    },
    "escalation_process": {
      "criteria": ["高风险问题", "关键路径延期", "重大变更需求"],
      "procedure": "immediate_notification + analysis + recommendation"
    }
  }
}