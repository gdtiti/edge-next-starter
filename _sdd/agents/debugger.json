      "调试知识库更新"
    ]
  },
  "triggers": [
    {
      "event": "bug_report",
      "condition": "用户反馈或测试发现缺陷",
      "priority": "high"
    },
    {
      "event": "test_failure",
      "condition": "自动化测试失败或覆盖率下降",
      "priority": "high"
    },
    {
      "event": "production_issue",
      "condition": "生产环境错误或性能问题",
      "priority": "critical"
    },
    {
      "event": "performance_regression",
      "condition": "性能指标下降或用户投诉",
      "priority": "high"
    }
  ],
  "workflow_integration": {
    "entry_points": [
      "/workflow:bug-diagnosis",
      "/cli:mode:bug-diagnosis",
