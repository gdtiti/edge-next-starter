    "collaboration": {
      "implementer": {
        "interaction": "提供问题分析和修复方案",
        "deliverables": ["诊断报告", "修复代码", "测试用例"]
      },
      "analyzer": {
        "interaction": "协作分析问题模式和趋势",
        "deliverables": ["趋势分析", "预防建议", "改进方案"]
      },
      "planner": {
        "interaction": "评估问题影响和资源需求",
        "deliverables": ["影响评估", "修复计划", "资源分配"]
      }
    }
  },
