  "scope": {
    "responsibilities": [
      "快速定位和诊断问题根因",
      "设计有效的解决方案和修复措施",
      "分析问题影响范围和风险评估",
      "制定预防措施和改进建议",
      "维护调试知识和最佳实践库"
